# Copy to .env.local and fill in. Every variable is optional; leaving one empty
# disables the feature it controls. Only NEXT_PUBLIC_* variables are exposed to
# the client bundle — never put secrets here.

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave empty to disable
# analytics.
NEXT_PUBLIC_GA_ID=

# Google AdSense. NEXT_PUBLIC_ADSENSE_CLIENT is the publisher ID (e.g.
# ca-pub-0000000000000000); NEXT_PUBLIC_ADSENSE_SLOT is the ad unit slot ID for
# the single manual unit shown under the schedule. Leave empty to disable ads.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=

# Optional base path when the site is not served from the domain root (e.g.
# /gta-skating). Leave empty for the custom-domain root deployment.
NEXT_PUBLIC_BASE_PATH=

# Firebase web app configuration. These values are public by design (they ship
# in the client bundle); access is enforced by Firestore security rules. Fill in
# from Firebase console → Project settings. Leave empty to disable busyness
# reports.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Buy Me a Coffee page URL (e.g. https://buymeacoffee.com/yourname), shown as a
# link in the sidebar footer. Leave empty to hide the link.
NEXT_PUBLIC_BUYMEACOFFEE_URL=
