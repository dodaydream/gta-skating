rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /busyReports/{reportId} {
      // Only the reporter may read their own report, used to detect a duplicate
      // submission. Enumeration is disabled so reports and their uid stay
      // private; `resource == null` covers a reporter's not-yet-created doc.
      allow get: if request.auth != null
        && (resource == null || resource.data.uid == request.auth.uid);
      allow list: if false;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid
        && request.resource.data.busy is number
        && request.resource.data.busy >= 1 && request.resource.data.busy <= 3
        && request.resource.data.programType is string
        && request.resource.data.programType.size() < 100
        && request.resource.data.programType in [
          'Public Skate', 'Pickup Hockey', 'Figure Skating',
          'Stick and Puck', 'Ringette', 'Ice Breakdancing'
        ]
        && request.resource.data.programStartAt is string
        && request.resource.data.programStartAt.size() < 50
        && request.resource.data.programEndsAt is string
        && request.resource.data.programEndsAt.size() < 50
        && request.resource.data.reportedAt == request.time; // serverTimestamp only
      allow update, delete: if false;
    }

    // Pre-aggregated busyness, written only by the Cloud Function (the admin SDK
    // bypasses rules) and read publicly by the client.
    match /busyAggregates/{venueId} {
      allow read: if true;
      allow write: if false;
    }

    // Aggregation watermark; the Cloud Function only.
    match /busyAggregateState/{doc} {
      allow read, write: if false;
    }
  }
}
